# Copy to `.env` and adjust. Bun loads `.env` automatically (no dotenv needed).
# `.env` is gitignored; this file is the documented set of variables.

# ---- Server (src/index.ts) --------------------------------------------------

# Port for `bun dev` / `bun start`. Default: 3000
PORT=3000

# `production` disables hot reload and browser console echo in the Bun server.
# Set automatically by `bun start`; leave unset for `bun dev`.
# NODE_ENV=production

# ---- Client (src/config/DomainConfiguration.ts) ------------------------------
# BUN_PUBLIC_* variables are inlined into the browser bundle at build time
# (`bun dev` and `bun run build`). They are the most explicit source and win
# over window.__APP_CONFIG__, HOSTNAME_MAP and the same-origin defaults.
# Leave both unset to use the in-process mock backend on the same origin
# (api "/api/", sock "ws(s)://<host>/push").

# REST base URL or path. A trailing slash is added if missing.
# BUN_PUBLIC_API_URL=https://api.example.com/api

# WebSocket push endpoint. Accepts a path, an http(s) URL or a ws(s) URL.
# BUN_PUBLIC_SOCK_URL=wss://api.example.com/push
